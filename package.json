{
  "name": "@jcodesmore/youtube-for-ai-agents",
  "version": "0.3.4",
  "description": "Give your AI agent YouTube: search, watch (transcripts with timestamps), channels, playlists, comments, frames, downloads, clips and highlight reels. No API key.",
  "mcpName": "io.github.JCodesMore/youtube-for-ai-agents",
  "type": "module",
  "main": ".opencode/plugins/youtube.js",
  "bin": {
    "youtube-for-ai-agents": "dist/index.js",
    "youtube-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    ".claude-plugin",
    ".cursor-plugin",
    "mcp.json",
    ".opencode",
    "gemini-extension.json",
    "GEMINI.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "JCodesMore",
    "url": "https://github.com/JCodesMore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCodesMore/youtube-for-ai-agents.git"
  },
  "homepage": "https://github.com/JCodesMore/youtube-for-ai-agents",
  "bugs": {
    "url": "https://github.com/JCodesMore/youtube-for-ai-agents/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "transcripts",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "search",
    "video",
    "transcript",
    "plugin",
    "youtube-transcript",
    "mcp-server",
    "claude-code-plugin",
    "opencode",
    "clips"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs",
    "prepublishOnly": "npm run check",
    "lock": "node scripts/lock.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
